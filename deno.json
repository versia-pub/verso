{
    "version": "0.0.0",
    "license": "AGPL-3.0-or-later",
    "vendor": true,
    "workspace": [
        "./packages/client-api",
        "./packages/protocol"
    ],
    "tasks": {
        "fmt": "deno fmt",
        "lint": "deno lint",
        "check": "deno check",
        "test": "deno test --allow-read=node_modules --allow-env",
        "unused-dependencies": "deno run --allow-read=. --allow-run=deno scripts/unused_dependencies.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 100
    },
    "lint": {
        "plugins": [
            "./lint/plugin.ts"
        ],
        "rules": {
            "tags": [
                "recommended"
            ],
            "include": [
                "ban-ts-comment",
                "explicit-module-boundary-types",
                "no-console",
                "no-explicit-any",
                "no-non-null-assertion",
                "no-unused-vars"
            ]
        }
    },
    "imports": {
        "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.9",
        "@hono/hono": "jsr:@hono/hono@4.13.13",
        "@logtape/logtape": "jsr:@logtape/logtape@2.4.1",
        "@panva/jose": "jsr:@panva/jose@6.2.12",
        "@panva/openid-client": "jsr:@panva/openid-client@6.8.8",
        "@std/assert": "jsr:@std/assert@1.0.19",
        "@std/cli": "jsr:@std/cli@1.0.32",
        "@std/toml": "jsr:@std/toml@1.0.11",
        "@types/pg": "npm:@types/pg@8.23.1",
        "fast-check": "npm:fast-check@4.10.2",
        "kysely": "npm:kysely@0.29.6",
        "pg": "npm:pg@8.23.1",
        "zod": "npm:zod@4.6.7"
    }
}
