{
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "vendor": true,
  "workspace": [
    "./packages/protocol"
  ],
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check",
    "test": "deno test",
    "unused-dependencies": "deno run --allow-read=. --allow-run=deno scripts/unused_dependencies.ts"
  },
  "lint": {
    "plugins": [
      "./lint/plugin.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-ts-comment",
        "explicit-module-boundary-types",
        "no-console",
        "no-explicit-any",
        "no-non-null-assertion",
        "no-unused-vars"
      ]
    }
  },
  "imports": {
    "@logtape/logtape": "jsr:@logtape/logtape@2.4.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "fast-check": "npm:fast-check@4.10.2",
    "zod": "npm:zod@4.6.7"
  }
}
